python -m specbridge.usecases.molgpt_from_spec \
  --mgf data/MassSpecGym.mgf \
  --dreams-ckpt data/ssl_model.ckpt \
  --adapter-ckpt runs/specbridge_align_chemberta_pub_v3f/ckpt_001400.pt \
  --cond-dim 2048 --mapper-hidden 2048 --no-gaussian \
  --chemberta-model Derify/ChemBERTa_augmented_pubchem_13m \
  --molgpt-ckpt ../molgpt/cond_gpt/weights/pub_13M.pt \
  --fold-query test \
  --samples-per-spec 64 --max-new-tokens 128 --temperature 0.8 --top-k 10 \
  --out-csv runs/molgpt_gen_from_spec.csv

